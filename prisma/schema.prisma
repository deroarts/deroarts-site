// DeroArts — Prisma schema (PostgreSQL / Supabase-ready)
// Translatable text fields use Json type with shape { "it": "...", "en": "" }.
// Gallery is a Json array with shape [{ url: string, alt: { it: string, en: string } }].

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  available
  coming_soon
  demo_available
}

enum ActionType {
  demo
  request_info
  download
  app_store
  play_store
  external
}

enum RequestStatus {
  new
  read
  handled
}

// Come è entrato il messaggio: dal form del sito, o email inoltrata (Zoho→Resend).
enum RequestSource {
  site
  email
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Category {
  id         String    @id @default(cuid())
  name       Json      // { it: string, en: string }
  slug       String    @unique
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  projects   Project[]

  @@index([slug])
  @@map("categories")
}

model Project {
  id                String          @id @default(cuid())
  slug              String          @unique
  title             Json            // { it: string, en: string }
  short_description Json            // { it: string, en: string }
  long_description  Json            // { it: string, en: string }
  status            ProjectStatus   @default(available)
  category          Category?       @relation(fields: [category_id], references: [id], onDelete: SetNull)
  category_id       String?
  cover_image_url   String?
  gallery           Json            @default("[]")
  published         Boolean         @default(false)
  sort_order        Int             @default(0)
  from_email        String?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  actions           ProjectAction[]
  requests          Request[]

  @@index([slug])
  @@index([category_id])
  @@index([status])
  @@index([published])
  @@map("projects")
}

model ProjectAction {
  id         String     @id @default(cuid())
  project    Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  project_id String
  type       ActionType
  label      Json       // { it: string, en: string }
  url        String?
  enabled    Boolean    @default(true)
  sort_order Int        @default(0)

  @@index([project_id])
  @@map("project_actions")
}

model Request {
  id         String        @id @default(cuid())
  project    Project?      @relation(fields: [project_id], references: [id], onDelete: SetNull)
  project_id String?
  name       String
  email      String
  message    String
  status     RequestStatus @default(new)
  created_at DateTime      @default(now())
  handled_at DateTime?
  // Timestamp of the last reply sent from the admin Messaggi panel (null = mai risposto).
  replied_at DateTime?
  // Origine del messaggio: "site" (form) o "email" (posta inoltrata da Zoho via Resend).
  source     RequestSource @default(site)
  // Subject della email inoltrata (null per i messaggi dal form).
  subject    String?
  // Indirizzo a cui l'admin risponde: per le email è il mittente reale, che può
  // differire dal campo `email` (che teniamo comunque = indirizzo del mittente).
  reply_to_email String?
  // ID Resend della email ricevuta — evita doppioni se il webhook ritenta.
  inbound_email_id String? @unique

  @@index([project_id])
  @@index([status])
  @@index([source])
  @@map("requests")
}

// Web-push subscription for one device/browser of the admin. One row per
// endpoint; deleting the row unsubscribes that device.
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now())

  @@map("push_subscriptions")
}

// Global on/off flags for admin notifications. Single-row table keyed by a
// stable string ("global"); keeps push preferences server-side.
model NotificationSetting {
  key            String   @id
  push_enabled   Boolean  @default(false)
  updated_at     DateTime @updatedAt

  @@map("notification_settings")
}

model DevOutbox {
  id         String   @id @default(cuid())
  to         String
  from       String
  subject    String
  body       String
  created_at DateTime @default(now())

  @@map("dev_outbox")
}
