# ============================================================
# DeroArts — Environment Variables
# Copy this file to .env and fill in values for local dev.
# Never commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string (Supabase). Same project for dev and prod,
# or a separate Supabase project for local development.
DATABASE_URL="postgresql://user:password@host:5432/deroarts"

# ── Session / Auth ──────────────────────────────────────────
# Secret used to sign and verify the session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Admin login credentials (single owner account).
# Password is compared against bcrypt hash stored in DB (or env-based check).
ADMIN_EMAIL="admin@deroarts.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# ── Mail adapter ────────────────────────────────────────────
# "fake"  → logs to console + writes to dev_outbox table (dev default)
# "smtp"  → sends real email via Zoho SMTP (production)
MAIL_MODE="fake"

# SMTP settings (only needed when MAIL_MODE=smtp)
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER="info@deroarts.com"
SMTP_PASS="your-zoho-app-password"

# Default sender address for all outgoing mail.
MAIL_FROM="info@deroarts.com"

# ── Storage adapter ──────────────────────────────────────────
# "local"    → writes files to public/uploads/, stores relative URL in DB (dev default)
# "supabase" → writes to Supabase Storage bucket (production)
STORAGE_MODE="local"

# Supabase credentials (only needed when STORAGE_MODE=supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="deroarts-assets"

# ── Agent API (external agents, e.g. Devin) ──────────────────
# Shared secret an external agent sends in the "x-api-key" header to
# GET published projects (read/contextualize) and POST new DRAFT projects.
# Drafts are never published automatically — the admin publishes manually.
# Generate with: openssl rand -hex 32. Leave empty to disable the endpoint.
AGENT_API_KEY=""

# ── Public URL ───────────────────────────────────────────────
# Base URL of the site (no trailing slash). Used for SEO metadata and sitemap.
NEXT_PUBLIC_SITE_URL="https://deroarts.com"

# ── User/Admin switcher (U/A pill) ───────────────────────────
# Visibility: shows the U/A pill everywhere INCL. production. Navigation only,
# does NOT bypass auth — in prod clicking "A" still requires the admin login.
NEXT_PUBLIC_SHOW_UA_SWITCH="true"
#
# Auth bypass (DEV ONLY): when "true" the middleware lets /admina through WITHOUT
# login. NEVER set to true in production. Leave false everywhere except local dev.
DEV_UA_SWITCH="false"
