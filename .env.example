# ============================================================
# DeroArts — Environment Variables
# Copy this file to .env and fill in values for local dev.
# Never commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
# Supabase Postgres. Due URL:
# - DATABASE_URL = pooler Transaction mode (porta 6543) + pgbouncer + connection_limit=1.
#   Usato a runtime: poche connessioni, non satura il pool free (limite 15). Su Render.
# - DIRECT_URL = connessione diretta Session mode (porta 5432). Usato SOLO dalle
#   migrazioni Prisma (il pooler non le supporta). Vedi `directUrl` in schema.prisma.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ── Session / Auth ──────────────────────────────────────────
# Secret used to sign and verify the session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Admin login credentials (single owner account).
# Il login usa nickname + PIN salvati nella tabella `admin_credentials`
# (PIN come hash bcrypt), modificabili da Impostazioni. Le due variabili qui
# sotto sono solo un FALLBACK di bootstrap se il DB è vuoto/irraggiungibile.
ADMIN_NICKNAME="dero"
ADMIN_PIN="140478"

# ── Mail adapter ────────────────────────────────────────────
# Il modulo contatti manda una email a info@deroarts.com (+ conferma al cliente).
# "fake"   → scrive solo in console (default in locale, nessun invio reale)
# "resend" → invio reale via API Resend (produzione)
MAIL_MODE="fake"

# Resend (only needed when MAIL_MODE=resend). Account: dero975@gmail.com.
# Domain deroarts.com must be Verified on Resend. Key from resend.com → API keys.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Storage adapter ──────────────────────────────────────────
# "local"    → writes files to public/uploads/, stores relative URL in DB (dev only)
# "supabase" → writes to a PUBLIC Supabase Storage bucket, stores the public CDN
#              URL (survives redeploys — required on Render, whose disk is ephemeral)
STORAGE_MODE="local"

# Supabase credentials (only needed when STORAGE_MODE=supabase)
SUPABASE_URL="https://your-project.supabase.co"
# ANON_KEY: non usata a runtime dall'app — serve solo come secret al
# workflow CI di keepalive (.github/workflows/supabase-keepalive.yml)
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="deroarts-assets"

# ── Agent API (external agents, e.g. Devin) ──────────────────
# Shared secret an external agent sends in the "x-api-key" header to
# GET published projects (read/contextualize) and POST new DRAFT projects.
# Drafts are never published automatically — the admin publishes manually.
# Generate with: openssl rand -hex 32. Leave empty to disable the endpoint.
AGENT_API_KEY=""

# ── Public URL ───────────────────────────────────────────────
# Base URL of the site (no trailing slash). Used for SEO metadata and sitemap.
NEXT_PUBLIC_SITE_URL="https://deroarts.com"

# ── User/Admin switcher (U/A pill) ───────────────────────────
# Visibility: shows the U/A pill everywhere INCL. production. Navigation only,
# does NOT bypass auth — in prod clicking "A" still requires the admin login.
NEXT_PUBLIC_SHOW_UA_SWITCH="true"
#
# Auth bypass (DEV ONLY): when "true" the middleware lets /admina through WITHOUT
# login. NEVER set to true in production. Leave false everywhere except local dev.
DEV_UA_SWITCH="false"
