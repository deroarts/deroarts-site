{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "./dist-seed"
  },
  "include": ["prisma/seed.ts"]
}
